# Obrigatória para usar as APIs Google.
GOOGLE_SOLAR_API_KEY=

# Endpoints HTTPS. Para API central compatível, use auth mode "none".
SOLAR_API_URL=https://solar.googleapis.com/v1/buildingInsights:findClosest
SOLAR_API_AUTH_MODE=google_api_key
GEOCODING_API_URL=https://maps.googleapis.com/maps/api/geocode/json

# Rede
REQUEST_TIMEOUT_SECONDS=15
HTTP_MAX_ATTEMPTS=3

# Painel comercial de referência e hipóteses ajustáveis
DEFAULT_TARIFF_REAIS_KWH=0.95
PANEL_REFERENCE=JA Solar JAM72S30-550/MR
PANEL_POWER_WATTS=550
PANEL_WIDTH_METERS=1.134
PANEL_HEIGHT_METERS=2.278
PANEL_MODULE_REFERENCE_PRICE_REAIS=780
INSTALLATION_LABOR_COST_PER_PANEL_REAIS=632.50
OTHER_SYSTEM_COST_PER_PANEL_REAIS=387.50
FALLBACK_PANEL_MONTHLY_KWH=65
SYSTEM_PERFORMANCE_RATIO=0.85
ANNUAL_PANEL_DEGRADATION_RATE=0.0055
